MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=wildmon
JWT_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:3000
STORAGE_MODE=local
# For production, set STORAGE_MODE=s3 and these values:
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# For an AI Studio key, use this URL. Wildmon calls Google's native generateContent API.
# Other hosts must expose an OpenAI-compatible vision chat-completions API.
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA_API_KEY=
GEMMA_MODEL=
# Maximum wait for each model response; a discovery can make two model calls.
GEMMA_TIMEOUT_SECONDS=120
